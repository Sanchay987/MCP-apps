# Azure OpenAI Configuration
# Copy this file to config.env and fill in your actual values

# Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=your-endpoint-here

# Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-api-key-here

# Deployment name for your GPT model (e.g., gpt-4, gpt-35-turbo)
AZURE_OPENAI_DEPLOYMENT=your-deployment-name-here

# API version (recommended: 2024-02-15-preview or later for tool support)
AZURE_OPENAI_API_VERSION=2024-02-15-preview
